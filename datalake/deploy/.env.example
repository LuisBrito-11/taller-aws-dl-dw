# Copiar a .env (NO versionar el real). En la EC2 se genera automaticamente y se sube a S3 privado.
DL_BUCKET=de-gr02-user-4-datalake-<ACCOUNT_ID>
DL_GLUE_DB=de_gr02_user_4_news
DL_ATHENA_WORKGROUP=de-gr02-user-4-wg
AWS_REGION=us-east-2
AIRFLOW_ADMIN_PASSWORD=<generar-aleatoria>
AIRFLOW_SECRET_KEY=<generar-aleatoria>
# Sin AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY: la EC2 usa el rol de instancia.
