# Variables requeridas por docker-compose (deploy/). El archivo real (.build/dw.env) se genera con
# create_infra.sh + deploy_ec2.sh, nunca se versiona y llega a la EC2 por S3 privado.
DW_BUCKET=de-gr02-user-4-dw-<ACCOUNT_ID>
AWS_REGION=us-east-2
MYSQL_HOST=<endpoint-rds>
MYSQL_USER=etl_admin
MYSQL_PASSWORD=<generada>
MYSQL_DATABASE=ecommerce
MONGO_HOST=<endpoint-cluster-docdb>
MONGO_USER=docdbadmin
MONGO_PASSWORD=<generada>
MONGO_DATABASE=ecommerce
REDSHIFT_HOST=<endpoint-workgroup-redshift-serverless>
REDSHIFT_USER=rsadmin
REDSHIFT_PASSWORD=<generada>
REDSHIFT_DATABASE=dev
REDSHIFT_IAM_ROLE=arn:aws:iam::<ACCOUNT_ID>:role/de-gr02-user-4-dw-redshift-s3-role
AIRFLOW_ADMIN_PASSWORD=<generada>
AIRFLOW_SECRET_KEY=<generada>
